/* Shared application style. Reload via View > Reload styles.
   Legacy appearance retained; local panel styles still take precedence. */
/* Application surfaces */
QFrame[fluentRole="inlineDivider"] {
    background: #c8d1dd;
    border: none;
}
/* Sidebar roles use the same light-theme surfaces and focus treatment as the
   application. Compact controls retain their font size and keyboard behavior. */
QLabel[fluentRole="sectionTitle"] {
    font-weight: 600;
}
QFrame[fluentRole="compactBar"] {
    background: #fafbfc;
    border: 1px solid #d7dee7;
    border-radius: 5px;
}
QRadioButton[fluentRole="modeOption"] {
    color: #243246;
    background: #ffffff;
    border: 1px solid #c8d1dd;
    border-radius: 5px;
    padding: 4px 8px;
    min-height: 24px;
    spacing: 5px;
}
QRadioButton[fluentRole="modeOption"]:hover {
    background: #edf5fd;
    border-color: #79a9d8;
}
QRadioButton[fluentRole="modeOption"]:checked {
    color: #174f87;
    background: #dcecfb;
    border-color: #2877c9;
    font-weight: 600;
}
QRadioButton[fluentRole="modeOption"]:pressed {
    background: #cddff3;
}
QRadioButton[fluentRole="modeOption"]:focus {
    border: 1px solid #174f87;
    outline: 1px solid #174f87;
}
QRadioButton[fluentRole="modeOption"]:disabled {
    color: #96a0ae;
    background: #edf0f4;
    border-color: #dce1e8;
}
QRadioButton[fluentRole="modeOption"]:checked:disabled {
    color: #667386;
    background: #e1e8f0;
    border-color: #a6b6c9;
}
QToolButton[fluentRole="sectionHeader"] {
    text-align: left;
    font-weight: 600;
    min-height: 24px;
    padding: 3px 6px;
    border: 1px solid transparent;
    border-bottom-color: #d9e0e9;
    border-radius: 4px;
    background: #eaf0f7;
}
QToolButton[fluentRole="sectionHeader"]:checked {
    background: #e3edf8;
    border-bottom-color: #b6cee7;
}
QToolButton[fluentRole="sectionHeader"]:hover {
    background: #dceafa;
}
QToolButton[fluentRole="sectionHeader"]:pressed {
    background: #cddff3;
}
QToolButton[fluentRole="sectionHeader"]:focus {
    border: 1px solid #2877c9;
}
QToolButton[fluentRole="sectionHeader"]:disabled {
    color: #8b96a5;
    background: #eef1f5;
    border-color: #dde2e9;
}
QWidget#ManualSMUControls QFrame[fluentRole="channelRow"] {
    border: none;
    border-bottom: 1px solid #d9e0e9;
    background: transparent;
}
QWidget#ManualSMUControls QPushButton,
QWidget#SpectrumConnectionSection QPushButton,
QWidget#SharedInstrumentHistorySidebar > QPushButton {
    min-height: 24px;
    padding: 2px 7px;
}
QWidget#ManualSMUControls QDoubleSpinBox {
    min-height: 24px;
    padding: 1px 7px;
}
QPushButton[fluentAppearance="danger"] {
    color: #9b2929;
}
QPushButton[fluentAppearance="danger"]:hover {
    color: #7e1919;
    background: #fff1f1;
    border-color: #cb7777;
}
QPushButton[fluentAppearance="danger"]:pressed {
    background: #f8dada;
}
QPushButton[fluentAppearance="danger"]:focus {
    border: 1px solid #2877c9;
}
QPushButton[fluentAppearance="danger"]:disabled {
    color: #96a0ae;
    background: #edf0f4;
    border-color: #dce1e8;
}

QWidget {
    color: #202936;
    selection-background-color: #2a75c7;
    selection-color: #ffffff;
}
QMainWindow, QDialog {
    background: #f3f6fa;
}
QToolTip {
    color: #202936;
    background: #ffffff;
    border: 1px solid #cfd7e3;
    border-radius: 5px;
    padding: 5px 7px;
}

/* Cards and sections */
QWidget#MegaSweepSettings QGroupBox[compactCard="true"] {
    margin-top: 11px;
    padding: 6px 5px 5px 5px;
    border-radius: 7px;
}
QWidget#MegaSweepSettings QGroupBox[compactCard="true"]::title {
    left: 8px;
    padding: 0 4px;
}
QGroupBox#MegaSweepEmbeddedGroup {
    border: none;
    margin: 0;
    padding: 0;
    background: transparent;
}
QGroupBox {
    background: #ffffff;
    font-weight: 600;
    border: 1px solid #d9e0e9;
    border-radius: 8px;
    margin-top: 14px;
    padding: 9px 8px 8px 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: 1px;
    padding: 0 5px;
    color: #29384c;
    background: #ffffff;
}
QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: #dce2ea;
}

/* Inputs */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox,
QDateEdit, QDateTimeEdit, QTimeEdit {
    min-height: 24px;
    color: #202936;
    background: #ffffff;
    border: 1px solid #cbd4e0;
    border-radius: 5px;
    padding: 2px 7px;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover,
QDateEdit:hover, QDateTimeEdit:hover, QTimeEdit:hover {
    border-color: #9caabd;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QDateEdit:focus, QDateTimeEdit:focus, QTimeEdit:focus {
    border: 1px solid #2574c7;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled,
QComboBox:disabled, QDateEdit:disabled, QDateTimeEdit:disabled,
QTimeEdit:disabled {
    color: #8b96a5;
    background: #eef1f5;
    border-color: #dde2e9;
}
QComboBox::drop-down {
    width: 24px;
    border: none;
    border-left: 1px solid #e1e6ed;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #cbd4e0;
    border-radius: 5px;
    padding: 3px;
    outline: none;
}
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    width: 18px;
    background: #f7f9fc;
    border: none;
    border-left: 1px solid #e2e7ee;
}
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background: #eaf2fb;
}
QPlainTextEdit, QTextEdit {
    color: #202936;
    background: #ffffff;
    border: 1px solid #d3dbe6;
    border-radius: 6px;
    padding: 4px;
}

/* Buttons */
QPushButton {
    min-height: 25px;
    color: #243246;
    background: #ffffff;
    border: 1px solid #c8d1dd;
    border-radius: 6px;
    padding: 4px 13px;
}
QPushButton:hover {
    color: #145da5;
    background: #edf5fd;
    border-color: #79a9d8;
}
QPushButton:pressed {
    background: #dcecfb;
    border-color: #4f8bc6;
}
QPushButton:focus, QPushButton:default {
    border: 1px solid #2877c9;
}
QPushButton:disabled {
    color: #96a0ae;
    background: #edf0f4;
    border-color: #dce1e8;
}
QToolButton {
    min-width: 22px;
    min-height: 22px;
    border: 1px solid transparent;
    border-radius: 5px;
    background: transparent;
}
QToolButton:hover {
    background: #e8f1fb;
    border-color: #c5d9ed;
}
QToolButton:pressed, QToolButton:checked {
    background: #d9eafa;
    border-color: #9fc1e2;
}

/* Navigation */
QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #d7dee8;
    border-radius: 0 8px 8px 8px;
    top: -1px;
}
QTabBar::tab {
    min-width: 76px;
    color: #667386;
    background: transparent;
    border: 1px solid transparent;
    border-bottom: 2px solid transparent;
    padding: 8px 17px;
    margin-right: 2px;
}
QTabBar::tab:hover:!selected {
    color: #245f9b;
    background: #edf4fb;
    border-radius: 6px 6px 0 0;
}
QTabBar::tab:selected {
    color: #174f87;
    background: #ffffff;
    border: 1px solid #d7dee8;
    border-bottom: 2px solid #2374c6;
    border-radius: 6px 6px 0 0;
    font-weight: 600;
}
QDockWidget {
    color: #202936;
}
QDockWidget::title {
    color: #2b3b4f;
    background: #eaf0f7;
    border-bottom: 1px solid #d2dbe6;
    padding: 7px 9px;
    font-weight: 600;
}

/* Data views */
QTableView, QTableWidget, QTreeView, QListView {
    alternate-background-color: #f7f9fc;
    background: #ffffff;
    border: 1px solid #d5dde7;
    border-radius: 6px;
    gridline-color: #e6eaf0;
    outline: none;
}
QTableView::item, QTableWidget::item, QTreeView::item, QListView::item {
    padding: 3px 5px;
}
QTableView::item:hover, QTableWidget::item:hover,
QTreeView::item:hover, QListView::item:hover {
    background: #edf5fd;
}
QTableView::item:selected, QTableWidget::item:selected,
QTreeView::item:selected, QListView::item:selected {
    color: #173b61;
    background: #d9eafb;
}
QHeaderView::section {
    color: #344358;
    background: #eef2f7;
    border: none;
    border-right: 1px solid #dde3eb;
    border-bottom: 1px solid #d5dde7;
    padding: 5px 7px;
    font-weight: 600;
}
QTableCornerButton::section {
    background: #eef2f7;
    border: none;
    border-right: 1px solid #dde3eb;
    border-bottom: 1px solid #d5dde7;
}

/* Feedback and structure */
QProgressBar {
    min-height: 17px;
    color: #344358;
    background: #e8edf3;
    border: 1px solid #d2dae5;
    border-radius: 6px;
    text-align: center;
    font-size: 11px;
}
QProgressBar::chunk {
    background: #2c7bc9;
    border-radius: 5px;
}
QStatusBar {
    color: #536174;
    background: #edf1f6;
    border-top: 1px solid #d5dce6;
    font-size: 11px;
}
QSplitter::handle {
    background: #e1e6ed;
}
QSplitter::handle:hover {
    background: #b7cbe0;
}

/* Scroll bars */
QScrollBar:vertical {
    width: 11px;
    margin: 2px;
    background: transparent;
}
QScrollBar::handle:vertical {
    min-height: 28px;
    background: #c4ceda;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover { background: #9eacbd; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    height: 0px;
    background: transparent;
}
QScrollBar:horizontal {
    height: 11px;
    margin: 2px;
    background: transparent;
}
QScrollBar::handle:horizontal {
    min-width: 28px;
    background: #c4ceda;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover { background: #9eacbd; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    width: 0px;
    background: transparent;
}


/* Reloadable panel appearances. UI code only selects semantic roles. */

/* dangerAction */
QPushButton[spectralRole="dangerAction"] {
    background:#b3261e;
    color:white;
    font-weight:bold;
}


/* sweepDisclosure */
QFrame#MegaSweepDisclosure {
    background: #ffffff;
    border: 1px solid #d9e0e9;
    border-radius: 7px;
}
QToolButton#MegaSweepDisclosureHeader {
    min-height: 24px;
    border: none;
    border-radius: 6px;
    padding: 4px 7px;
    color: #29384c;
    font-weight: 600;
    text-align: left;
    background: transparent;
}
QToolButton#MegaSweepDisclosureHeader:hover {
    background: #f0f5fb;
}


/* settingsSplitter */
QSplitter[spectralRole="settingsSplitter"]::handle {
    background: #d7e0ea;
    border-left: 1px solid #c7d2df;
    border-right: 1px solid #c7d2df;
}
QSplitter[spectralRole="settingsSplitter"]::handle:hover {
    background: #afc6dd;
}


/* rawLink */
QLabel[spectralRole="rawLink"] {
    color: #6a6a6a;
    font-size: 10px;
    padding: 1px 6px 2px 6px;
}


/* summary */
QTextEdit[spectralRole="summary"] {
    color: #444444;
    background: #f5f5f7;
    border: 1px solid #dedede;
    border-radius: 3px;
    padding: 4px 6px;
}


/* runAction */
QPushButton[spectralRole="runAction"] {
    font-weight: 700;
    font-size: 12px;
    border-color: #5a9060;
    color: #1a4020;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #d8f0d8, stop:1 #b8e0b8);
}
QPushButton[spectralRole="runAction"]:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #e8f8e8, stop:1 #c8ecc8);
}
QPushButton[spectralRole="runAction"]:pressed {
    background: #a8d8a8;
}
QPushButton[spectralRole="runAction"]:disabled {
    color: #aaaaaa;
    border-color: #d0d0d0;
    background: #f0f0f0;
}


/* stopAction */
QPushButton[spectralRole="stopAction"] {
    font-weight: 700;
    font-size: 12px;
    border-color: #a05050;
    color: #6a1010;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #f8dada, stop:1 #eec0c0);
}
QPushButton[spectralRole="stopAction"]:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #ffe8e8, stop:1 #f4cccc);
}
QPushButton[spectralRole="stopAction"]:pressed {
    background: #e0a8a8;
}
QPushButton[spectralRole="stopAction"]:disabled {
    color: #aaaaaa;
    border-color: #d0d0d0;
    background: #f0f0f0;
}


/* log */
QTextEdit[spectralRole="log"] {
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 11px;
    background: #fafafa;
    border: 1px solid #d0d0d0;
    border-radius: 3px;
}


/* motionControls */

            QWidget#MotionSweepControls QGroupBox {
    margin-top: 10px;
    padding: 3px 4px 4px 4px;
}

            QWidget#MotionSweepControls QLineEdit,
            QWidget#MotionSweepControls QComboBox,
            QWidget#MotionSweepControls QDoubleSpinBox,
            QWidget#MotionSweepControls QSpinBox {
    min-height: 20px;
    padding: 1px 4px;
}

            QWidget#MotionSweepControls QPushButton {
    min-height: 22px;
    padding: 2px 7px;
}

            QWidget#MotionSweepControls QCheckBox {
    min-height: 18px;
}



/* notice */
QLabel[spectralRole="notice"] {
    color: #9a6700;
    background: #fff8c5;
    border: 1px solid #d4a72c;
    border-radius: 3px;
    padding: 4px;
    font-size: 10px;
}


/* modeAction */
QPushButton[spectralRole="modeAction"]:checked {
    background: #dceafb;
    color: #174f8a;
    border: 1px solid #6497d0;
    font-weight: bold;
}


/* sweepCalculator */
QGroupBox#SweepLineCalculator {
    background: #f6f8fb;
    border: 1px solid #d8dee8;
    border-radius: 9px;
}
QGroupBox#SweepLineCalculator QFrame#SweepCalcCard {
    background: #ffffff;
    border: 1px solid #e1e6ee;
    border-radius: 7px;
}
QGroupBox#SweepLineCalculator QLabel#SweepCalcSectionTitle {
    color: #26364a;
    font-weight: 600;
    font-size: 12px;
    border: none;
}
QGroupBox#SweepLineCalculator QDoubleSpinBox, QGroupBox#SweepLineCalculator QSpinBox, QGroupBox#SweepLineCalculator QComboBox, QGroupBox#SweepLineCalculator QLineEdit {
    min-height: 24px;
    background: #ffffff;
    color: #202936;
    border: 1px solid #cbd3df;
    border-radius: 5px;
    padding: 0 5px;
}
QGroupBox#SweepLineCalculator QDoubleSpinBox:focus, QGroupBox#SweepLineCalculator QSpinBox:focus, QGroupBox#SweepLineCalculator QComboBox:focus, QGroupBox#SweepLineCalculator QLineEdit:focus {
    border: 1px solid #2878d0;
}
QGroupBox#SweepLineCalculator QPushButton#SweepCalcPrimary {
    min-height: 30px;
    color: white;
    background: #1769c2;
    border: 1px solid #1769c2;
    border-radius: 6px;
    padding: 2px 14px;
    font-weight: 600;
}
QGroupBox#SweepLineCalculator QPushButton#SweepCalcPrimary:hover {
    background: #0f5bab;
}
QGroupBox#SweepLineCalculator QPushButton#SweepCalcPrimary:pressed {
    background: #0b4d93;
}
QGroupBox#SweepLineCalculator QPushButton#SweepCalcPrimary:disabled {
    color: #8994a3;
    background: #e8ecf1;
    border-color: #d6dce5;
}
QGroupBox#SweepLineCalculator QToolButton {
    border: none;
    border-radius: 5px;
    background: #e5edf7;
}
QGroupBox#SweepLineCalculator QToolButton:hover {
    background: #d7e5f5;
}


/* loopSection */
QGroupBox#DualGateLoopSection {
    background: #FAF8FF;
    border: 1px solid #C4B5FD;
    border-left: 4px solid #7C3AED;
    border-radius: 7px;
    margin-top: 9px;
}
QGroupBox#DualGateLoopSection::title {
    color: #6D28D9;
    font-weight: 700;
    subcontrol-origin: margin;
    left: 9px;
    padding: 0 4px;
}


/* orderIndicator */
QLabel[spectralRole="orderIndicator"] {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 4px;
    padding: 4px 7px;
    color: #374151;
}


/* loopTable */
QTableWidget#DualGateLoopTable {
    background: #FFFFFF;
    gridline-color: #DDD6FE;
}
QTableWidget#DualGateLoopTable::item {
    padding: 2px 4px;
}
QTableWidget#DualGateLoopTable QHeaderView::section {
    background: #EDE9FE;
    color: #5B21B6;
    font-weight: 600;
    border: 0;
    border-right: 1px solid #DDD6FE;
    border-bottom: 1px solid #C4B5FD;
    padding: 4px;
}


/* batchSection */
QGroupBox#DualGateBatchSection {
    background: #F8FBFF;
    border: 1px solid #93C5FD;
    border-left: 4px solid #2563EB;
    border-radius: 7px;
    margin-top: 9px;
}
QGroupBox#DualGateBatchSection::title {
    color: #1D4ED8;
    font-weight: 700;
    subcontrol-origin: margin;
    left: 9px;
    padding: 0 4px;
}


/* batchTable */
QTableWidget#DualGateBatchTable {
    background: #FFFFFF;
    gridline-color: #BFDBFE;
}
QTableWidget#DualGateBatchTable::item {
    padding: 2px 4px;
}
QTableWidget#DualGateBatchTable QHeaderView::section {
    background: #DBEAFE;
    color: #1E40AF;
    font-weight: 600;
    border: 0;
    border-right: 1px solid #BFDBFE;
    border-bottom: 1px solid #93C5FD;
    padding: 4px;
}


/* applyAction */
QPushButton[spectralRole="applyAction"] {
    font-weight: 600;
    border-color: #90a8c0;
}
QPushButton[spectralRole="applyAction"]:hover {
    border-color: #5a82a8;
}


/* badge-success */
QLabel[spectralRole="badge"][spectralTone="success"] {
    padding: 3px 8px;
    border-radius: 8px;
    color: #23642c;
    background: #e6f4e8;
    border: 1px solid #b9ddbe;
}


/* safetyBar */
QFrame#DualGateSafetyBar {
    background: #FAFBFC;
    border: 1px solid #D7DEE7;
    border-radius: 5px;
}


/* loopAction */
QPushButton[spectralRole="loopAction"] {
    color: #5B21B6;
    background: #F5F3FF;
    border: 1px solid #C4B5FD;
    border-radius: 4px;
    padding: 4px;
}
QPushButton[spectralRole="loopAction"]:hover {
    background: #EDE9FE;
}


/* badge-danger */
QLabel[spectralRole="badge"][spectralTone="danger"] {
    padding: 3px 8px;
    border-radius: 8px;
    color: #9b1c15;
    background: #fde8e7;
    border: 1px solid #efb7b3;
}


/* message-warning */
QLabel[spectralRole="message"][spectralTone="warning"] {
    padding: 6px 8px;
    color: #765000;
    background: #fff5d9;
    border: 1px solid #ecd69c;
    border-radius: 6px;
}


/* message-danger */
QLabel[spectralRole="message"][spectralTone="danger"] {
    padding: 6px 8px;
    color: #8f2019;
    background: #fff0ef;
    border: 1px solid #efc1bd;
    border-radius: 6px;
}


/* message-success */
QLabel[spectralRole="message"][spectralTone="success"] {
    padding: 6px 8px;
    color: #24652d;
    background: #edf8ee;
    border: 1px solid #bedfc2;
    border-radius: 6px;
}


/* badge-warning */
QLabel[spectralRole="badge"][spectralTone="warning"] {
    padding: 3px 8px;
    border-radius: 8px;
    color: #8a5200;
    background: #fff3d6;
    border: 1px solid #ead097;
}


/* tableAction */
QPushButton[spectralRole="tableAction"] {
    min-height: 0px;
    padding: 2px 4px;
}


/* Shared text aliases retain the established light appearance. */
QWidget[spectralTone="primary"] {
    color: #202936;
}
QWidget[spectralTone="secondary"] {
    color: #4b5563;
}
QWidget[spectralTone="muted"] {
    color: #6b7280;
}
QWidget[spectralTone="info"] {
    color: #2563eb;
}
QWidget[spectralTone="success"] {
    color: #23642c;
}
QWidget[spectralTone="warning"] {
    color: #8a5200;
}
QWidget[spectralTone="danger"] {
    color: #b42318;
}
QWidget[spectralTextSize="caption"] {
    font-size: 10px;
}
QWidget[spectralTextSize="status"] {
    font-size: 11px;
}
QWidget[spectralTextSize="heading"] {
    font-size: 13px;
}
QWidget[spectralStrong="true"] {
    font-weight: 600;
}
QWidget[spectralRole="monospace"] {
    font-family: monospace;
}
QWidget[spectralRole="text"]:disabled {
    color: #96a0ae;
}
QTextEdit[spectralRole="summary"][spectralTone="danger"] {
    color: #b42318;
}
QTextEdit[spectralRole="summary"][spectralTone="warning"] {
    color: #8a5200;
}
QTextEdit[spectralRole="summary"][spectralTone="secondary"] {
    color: #4b5563;
}

/* Keyboard focus stays visible for the colored measurement controls. */
QPushButton[spectralRole="runAction"]:focus,
QPushButton[spectralRole="stopAction"]:focus,
QPushButton[spectralRole="dangerAction"]:focus,
QPushButton[spectralRole="loopAction"]:focus,
QPushButton[spectralRole="applyAction"]:focus,
QPushButton[spectralRole="modeAction"]:focus,
QPushButton[spectralRole="tableAction"]:focus,
QGroupBox#SweepLineCalculator QPushButton#SweepCalcPrimary:focus {
    border: 1px solid #174f87;
}
QPushButton[spectralRole="dangerAction"]:hover {
    background: #8f2019;
}
QPushButton[spectralRole="dangerAction"]:pressed {
    background: #711b16;
}
QPushButton[spectralRole="loopAction"]:pressed {
    background: #ddd6fe;
}
QPushButton[spectralRole="applyAction"]:pressed {
    background: #dceafb;
}
QPushButton[spectralRole="modeAction"]:checked:hover {
    background: #cdddF2;
}
QPushButton[spectralRole="modeAction"]:checked:pressed {
    background: #bdd2ec;
}
QPushButton[spectralRole="dangerAction"]:disabled,
QPushButton[spectralRole="loopAction"]:disabled,
QPushButton[spectralRole="applyAction"]:disabled,
QPushButton[spectralRole="modeAction"]:disabled {
    color: #96a0ae;
    background: #edf0f4;
    border-color: #dce1e8;
}
QToolButton#MegaSweepDisclosureHeader:pressed {
    background: #dceafb;
}
QToolButton#MegaSweepDisclosureHeader:focus {
    border: 1px solid #2877c9;
}
QToolButton#MegaSweepDisclosureHeader:disabled {
    color: #96a0ae;
}
QGroupBox#SweepLineCalculator QToolButton:pressed {
    background: #c7daf0;
}
QGroupBox#SweepLineCalculator QToolButton:focus {
    border: 1px solid #2877c9;
}
QGroupBox#SweepLineCalculator QToolButton:disabled {
    background: #edf0f4;
    color: #96a0ae;
}
QDoubleSpinBox[spectralRole="invalid"] {
    border: 1px solid #b42318;
}
QDoubleSpinBox[spectralRole="invalid"]:focus {
    border: 2px solid #b42318;
}
